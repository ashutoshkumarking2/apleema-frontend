import { useEffect, useState } from "react"
import { signOut } from "firebase/auth"
import { toast } from "sonner"
import { auth } from "./firebase"
import { api } from "./api"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"

type Status = {
  github: boolean
  githubLogin: string | null
  vercel: boolean
}

type Provider = "github" | "vercel"
type DisconnectTarget = {
  name: string
  path: string
  provider: Provider
}
type Reason =
  | "different_account"
  | "security_privacy"
  | "not_working"
  | "other"

const reasons: { value: Reason; label: string }[] = [
  {
    value: "different_account",
    label: "I want to connect a different account",
  },
  {
    value: "security_privacy",
    label: "Security or privacy concerns",
  },
  {
    value: "not_working",
    label: "Connection is not working properly",
  },
  { value: "other", label: "Other reason (optional details)" },
]

export default function Settings() {
  const [status, setStatus] = useState<Status | null>(null)
  const [showSignOut, setShowSignOut] = useState(false)
  const [confirmEmail, setConfirmEmail] = useState("")
  const [busy, setBusy] = useState(false)

  const [disconnectTarget, setDisconnectTarget] =
    useState<DisconnectTarget | null>(null)
  const [challengeId, setChallengeId] = useState("")
  const [challengeCode, setChallengeCode] = useState("")
  const [typedCode, setTypedCode] = useState("")
  const [challengeLoading, setChallengeLoading] = useState(false)
  const [challengeError, setChallengeError] = useState("")
  const [step, setStep] = useState<1 | 2 | 3>(1)
  const [reason, setReason] = useState<Reason | "">("")
  const [switchProvider, setSwitchProvider] = useState<Provider | "">("")
  const [details, setDetails] = useState("")
  const [disconnectBusy, setDisconnectBusy] = useState(false)

  const accountEmail = auth.currentUser?.email || ""
  const emailMatches =
    !!accountEmail &&
    confirmEmail.trim().toLowerCase() === accountEmail.trim().toLowerCase()

  async function load() {
    try {
      const data = await api.get("/api/status")
      setStatus(data as Status)
    } catch (e) {
      toast.error((e as Error).message || "Could not load connection status")
    }
  }

  useEffect(() => {
    void load()
  }, [])

  async function handleSignOut() {
    if (!emailMatches || busy) return

    setBusy(true)
    try {
      await signOut(auth)
      setShowSignOut(false)
      setConfirmEmail("")
      toast.success("Signed out successfully")
    } catch (e) {
      toast.error((e as Error).message || "Sign out failed")
    } finally {
      setBusy(false)
    }
  }

  async function openDisconnect(
    name: string,
    path: string,
    provider: Provider
  ) {
    setDisconnectTarget({ name, path, provider })
    setChallengeId("")
    setChallengeCode("")
    setTypedCode("")
    setChallengeError("")
    setStep(1)
    setReason("")
    setDetails("")
    setChallengeLoading(true)

    try {
      const result = await api.post("/api/disconnect-challenge", {
        provider,
      })

      setChallengeId(result.challengeId)
      setChallengeCode(result.code)
    } catch (e) {
      setChallengeError(
        (e as Error).message || "Could not create a confirmation code"
      )
    } finally {
      setChallengeLoading(false)
    }
  }

  function cancelDisconnect() {
    if (disconnectBusy) return
    setDisconnectTarget(null)
    setChallengeId("")
    setChallengeCode("")
    setTypedCode("")
    setChallengeError("")
    setStep(1)
    setReason("")
    setDetails("")
  }

  async function confirmDisconnect() {
    if (
      !disconnectTarget ||
      !challengeId ||
      typedCode !== challengeCode ||
      !reason ||
      disconnectBusy
    ) {
      return
    }

    setDisconnectBusy(true)
    try {
      await api.del(disconnectTarget.path, {
        challengeId,
        code: typedCode,
        reason,
        ...(reason === "other" ? { details: details.trim() } : {}),
      })

      toast.success(`${disconnectTarget.name} disconnected`)
      setDisconnectTarget(null)
      setChallengeId("")
      setChallengeCode("")
      setTypedCode("")
      setReason("")
      setDetails("")
      setStep(1)
      await load()
    } catch (e) {
      toast.error((e as Error).message || "Disconnect failed")
    } finally {
      setDisconnectBusy(false)
    }
  }

  const rows = [
    {
      name: "GitHub",
      provider: "github" as const,
      on: status?.github,
      path: "/api/github",
    },
    {
      name: "Vercel",
      provider: "vercel" as const,
      on: status?.vercel,
      path: "/api/vercel",
    },
  ]

  return (
    <div className="flex flex-col gap-4">
      <h1 className="text-2xl font-semibold">Settings</h1>

      <Card>
        <CardHeader>
          <CardTitle>Account</CardTitle>
          <CardDescription>
            {accountEmail ||
              auth.currentUser?.displayName ||
              "Signed-in account"}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <Button
            variant="outline"
            onClick={() => {
              setConfirmEmail("")
              setShowSignOut(true)
            }}
          >
            Sign out
          </Button>
        </CardContent>
      </Card>

      {rows.map((r) => (
        <Card key={r.name}>
          <CardContent className="flex items-center justify-between gap-2">
            <div className="flex items-center gap-2">
              <span className="font-medium">{r.name}</span>
              <Badge variant={r.on ? "default" : "secondary"}>
                {r.on ? "Connected" : "Not connected"}
              </Badge>
            </div>

            {r.on && (
              <Button
                variant="outline"
                size="sm"
                onClick={() =>
                  void openDisconnect(r.name, r.path, r.provider)
                }
              >
                Disconnect
              </Button>
            )}
          </CardContent>
        </Card>
      ))}

      {showSignOut && (
        <div
          className="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 p-4"
          onMouseDown={(e) => {
            if (e.target === e.currentTarget && !busy) {
              setShowSignOut(false)
              setConfirmEmail("")
            }
          }}
        >
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="signout-title"
            className="w-full max-w-md rounded-xl border bg-background p-6 text-foreground shadow-2xl"
          >
            <h2 id="signout-title" className="text-lg font-semibold">
              Are you sure you want to sign out?
            </h2>
            <p className="mt-2 text-sm text-muted-foreground">
              Enter your account email address to confirm.
            </p>

            <label
              htmlFor="confirm-email"
              className="mt-5 block text-sm font-medium"
            >
              Confirm email
            </label>
            <input
              id="confirm-email"
              type="email"
              autoComplete="email"
              autoFocus
              placeholder="Enter your email address"
              value={confirmEmail}
              onChange={(e) => setConfirmEmail(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter" && emailMatches) void handleSignOut()
                if (e.key === "Escape" && !busy) {
                  setShowSignOut(false)
                  setConfirmEmail("")
                }
              }}
              className="mt-2 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
            />

            {confirmEmail.length > 0 && !emailMatches && (
              <p className="mt-2 text-sm text-destructive">
                Email does not match your account.
              </p>
            )}

            <div className="mt-6 flex justify-end gap-2">
              <Button
                type="button"
                variant="outline"
                disabled={busy}
                onClick={() => {
                  setShowSignOut(false)
                  setConfirmEmail("")
                }}
              >
                Cancel
              </Button>
              <Button
                type="button"
                variant="destructive"
                disabled={!emailMatches || busy}
                onClick={() => void handleSignOut()}
              >
                {busy ? "Signing out..." : "Confirm Sign Out"}
              </Button>
            </div>
          </div>
        </div>
      )}

      {disconnectTarget && (
        <div
          className="fixed inset-0 z-[110] flex items-center justify-center bg-black/60 p-4"
          onMouseDown={(e) => {
            if (e.target === e.currentTarget) cancelDisconnect()
          }}
        >
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="disconnect-title"
            className="w-full max-w-md rounded-xl border bg-background p-6 text-foreground shadow-2xl"
          >
            <h2 id="disconnect-title" className="text-lg font-semibold">
              Disconnect {disconnectTarget.name}?
            </h2>

            {challengeLoading && (
              <p className="mt-4 text-sm text-muted-foreground">
                Generating a secure confirmation challenge...
              </p>
            )}

            {challengeError && (
              <div className="mt-4">
                <p className="text-sm text-destructive">{challengeError}</p>
                <Button
                  className="mt-3"
                  variant="outline"
                  onClick={cancelDisconnect}
                >
                  Close
                </Button>
              </div>
            )}

            {!challengeLoading && !challengeError && step === 1 && (
              <>
                <p className="mt-2 text-sm text-muted-foreground">
                  Manually type the 8-digit code. It expires after 5 minutes.
                </p>

                <div
                  className="mt-5 select-none rounded-lg border bg-muted/40 p-4 text-center"
                  onCopy={(e) => e.preventDefault()}
                  onCut={(e) => e.preventDefault()}
                  onContextMenu={(e) => e.preventDefault()}
                >
                  <p className="text-xs text-muted-foreground">
                    Confirmation code
                  </p>
                  <p className="mt-2 select-none font-mono text-3xl font-bold tracking-[0.3em]">
                    {challengeCode}
                  </p>
                </div>

                <label
                  htmlFor="disconnect-code"
                  className="mt-5 block text-sm font-medium"
                >
                  Enter code
                </label>
                <input
                  id="disconnect-code"
                  type="text"
                  inputMode="numeric"
                  autoComplete="off"
                  maxLength={8}
                  placeholder="Type all 8 digits"
                  value={typedCode}
                  onChange={(e) =>
                    setTypedCode(e.target.value.replace(/\D/g, "").slice(0, 8))
                  }
                  onPaste={(e) => e.preventDefault()}
                  onCopy={(e) => e.preventDefault()}
                  onCut={(e) => e.preventDefault()}
                  onContextMenu={(e) => e.preventDefault()}
                  onKeyDown={(e) => {
                    if (
                      (e.ctrlKey || e.metaKey) &&
                      ["c", "v", "x"].includes(e.key.toLowerCase())
                    ) {
                      e.preventDefault()
                    }
                    if (e.key === "Escape") cancelDisconnect()
                    if (e.key === "Enter" && typedCode === challengeCode) {
                      setStep(2)
                    }
                  }}
                  className="mt-2 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-lg tracking-widest outline-none focus:ring-2 focus:ring-ring"
                />

                {typedCode.length === 8 && typedCode !== challengeCode && (
                  <p className="mt-2 text-sm text-destructive">
                    Code does not match. Please check and try again.
                  </p>
                )}

                <div className="mt-6 flex justify-end gap-2">
                  <Button
                    type="button"
                    variant="outline"
                    onClick={cancelDisconnect}
                  >
                    Cancel
                  </Button>
                  <Button
                    type="button"
                    disabled={
                      typedCode.length !== 8 ||
                      typedCode !== challengeCode
                    }
                    onClick={() => setStep(2)}
                  >
                    Continue
                  </Button>
                </div>
              </>
            )}

            {!challengeLoading && !challengeError && step === 2 && (
              <>
                <p className="mt-2 text-sm text-muted-foreground">
                  Why do you want to disconnect {disconnectTarget.name}?
                </p>

                <div className="mt-4 space-y-3">
                  {reasons.map((item) => (
                    <label
                      key={item.value}
                      className="flex cursor-pointer items-start gap-3 text-sm"
                    >
                      <input
                        type="radio"
                        name="disconnect-reason"
                        value={item.value}
                        checked={reason === item.value}
                        onChange={() => setReason(item.value)}
                        className="mt-1"
                      />
                      <span>{item.label}</span>
                    </label>
                  ))}
                </div>

                {reason === "different_account" && (
                  <div className="mt-4 rounded-lg border p-3">
                    <p className="text-sm font-medium">
                      Which account do you want to switch?
                    </p>
                    <p className="mt-1 text-xs text-muted-foreground">
                      Choose the provider whose saved connection should be replaced.
                    </p>
                    <div className="mt-3 grid grid-cols-2 gap-2">
                      <Button
                        type="button"
                        variant={switchProvider === "github" ? "default" : "outline"}
                        onClick={() => setSwitchProvider("github")}
                      >
                        GitHub
                      </Button>
                      <Button
                        type="button"
                        variant={switchProvider === "vercel" ? "default" : "outline"}
                        onClick={() => setSwitchProvider("vercel")}
                      >
                        Vercel
                      </Button>
                    </div>
                    {switchProvider && (
                      <p className="mt-2 text-xs text-muted-foreground">
                        {switchProvider === "github"
                          ? "The GitHub connection will be removed. You can then authorize the other GitHub account."
                          : "The Vercel connection will be removed. You can then authorize the other Vercel account."}
                      </p>
                    )}
                  </div>
                )}

                {reason === "other" && (
                  <div className="mt-4">
                    <label
                      htmlFor="disconnect-details"
                      className="block text-sm font-medium"
                    >
                      Details (optional)
                    </label>
                    <textarea
                      id="disconnect-details"
                      maxLength={500}
                      rows={3}
                      value={details}
                      onChange={(e) => setDetails(e.target.value)}
                      placeholder="Tell us more (optional)"
                      className="mt-2 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
                    />
                    <p className="mt-1 text-xs text-muted-foreground">
                      {details.length}/500 characters
                    </p>
                  </div>
                )}

                <div className="mt-6 flex justify-end gap-2">
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() => setStep(1)}
                  >
                    Back
                  </Button>
                  <Button
                    type="button"
                    disabled={!reason}
                    onClick={() => setStep(3)}
                  >
                    Continue
                  </Button>
                </div>
              </>
            )}

            {!challengeLoading && !challengeError && step === 3 && (
              <>
                <p className="mt-3 text-sm text-muted-foreground">
                  You are about to disconnect {disconnectTarget.name}. This
                  removes its saved connection from Apleema.
                </p>
                <div className="mt-4 rounded-lg border p-3 text-sm">
                  <p>
                    <span className="font-medium">Reason: </span>
                    {reasons.find((item) => item.value === reason)?.label}
                  </p>
                  {reason === "other" && details.trim() && (
                    <p className="mt-2 break-words">
                      <span className="font-medium">Details: </span>
                      {details.trim()}
                    </p>
                  )}
                </div>
                <p className="mt-3 text-sm">
                  Confirm only if you want to proceed.
                </p>

                <div className="mt-6 flex justify-end gap-2">
                  <Button
                    type="button"
                    variant="outline"
                    disabled={disconnectBusy}
                    onClick={cancelDisconnect}
                  >
                    Cancel
                  </Button>
                  <Button
                    type="button"
                    variant="destructive"
                    disabled={!reason || disconnectBusy}
                    onClick={() => void confirmDisconnect()}
                  >
                    {disconnectBusy ? "Disconnecting..." : "Confirm Disconnect"}
                  </Button>
                </div>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  )
}

