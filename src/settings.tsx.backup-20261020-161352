import { useEffect, useState } from "react"
import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import { Input } from "@/components/ui/input"
import { signOut } from "firebase/auth"
import { toast } from "sonner"
import { auth } from "./firebase"
import { api } from "./api"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"

type Status = { github: boolean; githubLogin: string | null; vercel: boolean }

export default function Settings() {
  const [status, setStatus] = useState<Status | null>(null)
  const [signOutOpen, setSignOutOpen] = useState(false)
  const [confirmEmail, setConfirmEmail] = useState("")
  const [signingOut, setSigningOut] = useState(false)
  const accountEmail = auth.currentUser?.email || ""
  const emailMatches = !!accountEmail && confirmEmail.trim().toLowerCase() === accountEmail.trim().toLowerCase()
  const load = () => api.get("/api/status").then(setStatus).catch((e) => toast.error(e.message))
  useEffect(() => {
    load()
  }, [])

  async function confirmSignOut() {
    if (!emailMatches || signingOut) return
    setSigningOut(true)
    try {
      await signOut(auth)
      setSignOutOpen(false)
      setConfirmEmail("")
      toast.success("Signed out successfully")
    } catch (e) {
      toast.error((e as Error).message || "Could not sign out")
    } finally {
      setSigningOut(false)
    }
  }

  async function disconnect(path: string) {
    try {
      await api.del(path)
      toast.success("Disconnected")
      load()
    } catch (e) {
      toast.error((e as Error).message)
    }
  }

  const rows = [
    { name: "GitHub", on: status?.github, path: "/api/github" },
    { name: "Vercel", on: status?.vercel, path: "/api/vercel" },
  ]

  return (
    <div className="flex flex-col gap-4">
      <h1 className="text-2xl font-semibold">Settings</h1>
      <Card>
        <CardHeader>
          <CardTitle>Account</CardTitle>
          <CardDescription>{auth.currentUser?.email || auth.currentUser?.displayName}</CardDescription>
        </CardHeader>
        <CardContent>
          <Button variant="outline" onClick={() => { setConfirmEmail(""); setSignOutOpen(true) }}>Sign out</Button>
          <Dialog open={signOutOpen} onOpenChange={(open) => { if (!signingOut) { setSignOutOpen(open); if (!open) setConfirmEmail("") } }}>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Are you sure you want to sign out?</DialogTitle>
                <DialogDescription>Enter your account email to confirm signing out.</DialogDescription>
              </DialogHeader>
              <div className="flex flex-col gap-2">
                <p className="text-sm text-muted-foreground">Account: {accountEmail || "No email available"}</p>
                <Input type="email" autoComplete="email" placeholder="Enter your email address" value={confirmEmail} onChange={(e) => setConfirmEmail(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter" && emailMatches) void confirmSignOut() }} />
                {confirmEmail.length > 0 && !emailMatches && <p className="text-sm text-destructive">Email does not match your account.</p>}
              </div>
              <DialogFooter>
                <Button variant="outline" disabled={signingOut} onClick={() => { setSignOutOpen(false); setConfirmEmail("") }}>Cancel</Button>
                <Button variant="destructive" disabled={!emailMatches || signingOut} onClick={() => void confirmSignOut()}>{signingOut ? "Signing out..." : "Confirm Sign Out"}</Button>
              </DialogFooter>
            </DialogContent>
          </Dialog>
        </CardContent>
      </Card>
      {rows.map((r) => (
        <Card key={r.name}>
          <CardContent className="flex items-center justify-between gap-2">
            <div className="flex items-center gap-2">
              <span className="font-medium">{r.name}</span>
              <Badge variant={r.on ? "default" : "secondary"}>{r.on ? "Connected" : "Not connected"}</Badge>
            </div>
            {r.on && (
              <Button variant="outline" size="sm" onClick={() => disconnect(r.path)}>Disconnect</Button>
            )}
          </CardContent>
        </Card>
      ))}
    </div>
  )
}
